{
  "name": "kpop-diary",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @kpop-diary/web dev",
    "build": "pnpm --filter @kpop-diary/web build",
    "preview": "pnpm --filter @kpop-diary/web preview",
    "typecheck": "pnpm --filter @kpop-diary/web exec tsc -b",
    "test": "pnpm --filter @kpop-diary/web test"
  }
}